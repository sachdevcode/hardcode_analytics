# YouTube Data API v3 key (required for ingestion). Get one at:
# https://console.cloud.google.com/apis/credentials (enable YouTube Data API v3)
YOUTUBE_API_KEY=your_key_here

# Server
PORT=3001
NODE_ENV=development

# Database: leave unset or set to "sqlite" to use SQLite (no Postgres needed).
# Optional: path for SQLite file (default: ./data/hardscope.db)
# DB_PATH=./data/hardscope.db

# For Postgres instead, set DATABASE_URL and the app will use it:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hardscope
